#!/bin/bash

RESULTS_FILE="/opt/your-service/test_results/functionality_report.json"

if [ -f "$RESULTS_FILE" ]; then
    echo "🔍 СТАТУС ФУНКЦИОНАЛЬНОСТИ:"
    echo "================================"
    
    # Краткий вывод
    cat "$RESULTS_FILE" | grep -o '"results": \[.*\]' | \
    sed 's/"results": \[//' | sed 's/\]//' | \
    sed 's/", "/\n/g' | sed 's/"//g' | \
    while read line; do
        echo "  $line"
    done
    
    echo "================================"
    
    # Статистика
    working=$(grep -o '✅' "$RESULTS_FILE" | wc -l)
    broken=$(grep -o '❌' "$RESULTS_FILE" | wc -l)
    echo "✅ Работает: $working проверок"
    echo "❌ Не работает: $broken проверок"
    
    if [ $broken -gt 0 ]; then
        echo ""
        echo "💡 Детали ошибок:"
        grep -A2 '"❌' "$RESULTS_FILE" | grep -v '^--$' || true
    fi
    
else
    echo "❌ Файл с результатами не найден"
    exit 1
fi
